
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Check authentication
    function signedIn() {
      return request.auth != null;
    }

    // Check owner role from Firestore
    function isOwner() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'owner';
    }

    // Validate uploaded images
    function validImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Product images
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner() && validImage();
      allow delete: if isOwner();
    }

    // Category images
    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner() && validImage();
      allow delete: if isOwner();
    }

    // Machine images
    match /machines/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner() && validImage();
      allow delete: if isOwner();
    }
  }
}
